{
  "expo": {
    "name": "KaamAsaan",
    "slug": "kaamasaan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "backgroundColor": "#FFFBF2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7E6"
      },
      "package": "com.kaamasaan.mobile"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFBF2",
      "barStyle": "dark-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0ed21df1-a473-4ba4-a4f9-132e2b5d9cf3"
      }
    },
    "owner": "mwaqarali2110s-organization",
    "plugins": [
      "expo-video",
      "expo-sharing",
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/onboarding/Splash-Screen-Cart-1-transparent.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFF4DC",
          "dark": {
            "image": "./src/assets/onboarding/Splash-Screen-Cart-1-transparent.png",
            "backgroundColor": "#FFF4DC"
          }
        }
      ]
    ]
  }
}
