{
  "expo": {
    "name": "KaamAsaan",
    "slug": "kaamasaan",
    "version": "0.1.0",
    "icon": "./assets/branding/kaamasaan-app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "versionCode": 5,
      "icon": "./assets/branding/kaamasaan-app-icon.png",
      "softwareKeyboardLayoutMode": "pan",
      "backgroundColor": "#FFFBF2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/kaamasaan-adaptive-foreground.png",
        "backgroundColor": "#FFF5DE"
      },
      "package": "com.kaamasaan.mobile"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFBF2",
      "barStyle": "dark-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/branding/kaamasaan-favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0ed21df1-a473-4ba4-a4f9-132e2b5d9cf3"
      }
    },
    "owner": "mwaqarali2110s-organization",
    "plugins": [
      "expo-video",
      "expo-sharing",
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/kaamasaan-native-splash-logo.png",
          "backgroundColor": "#FFF5DE",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
